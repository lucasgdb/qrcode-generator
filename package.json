{
  "name": "qrcode-generator",
  "version": "1.0.0",
  "description": "A workbench to create, customize and export QR codes",
  "private": true,
  "author": "Lucas Bittencourt <lucasgdbittencourt@gmail.com> (https://lucasbittencourt.dev/)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" next.config.js postcss.config.js eslint.config.mjs tsconfig.json package.json README.md",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "country-flag-icons": "1.6.20",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgdb/qrcode-generator.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgdb/qrcode-generator/issues"
  }
}
