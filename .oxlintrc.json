{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Setting plugins replaces Oxlint's defaults, so they are listed along with React, Next and a11y.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y", "import"],
  // Type-aware rules run on TypeScript 7 through oxlint-tsgolint; `tsc` still owns type checking.
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "next": {
      "rootDir": "."
    },
    "react": {
      "version": "19"
    }
  },
  "rules": {
    // What eslint-config-next/core-web-vitals enforced.
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-sync-scripts": "error",
    "nextjs/no-img-element": "warn",
    "nextjs/no-head-element": "warn",
    "nextjs/no-css-tags": "warn",
    "nextjs/no-page-custom-font": "warn",
    "nextjs/no-title-in-document-head": "warn",
    "nextjs/no-duplicate-head": "error",
    "nextjs/no-head-import-in-document": "error",
    "nextjs/no-document-import-in-page": "error",
    "nextjs/no-styled-jsx-in-document": "error",
    "nextjs/no-typos": "error",
    "nextjs/inline-script-id": "error",

    // Hooks, including the React Compiler's set-state rules.
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/jsx-key": "error",
    "react/no-direct-mutation-state": "error",

    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/aria-props": "warn",
    "jsx-a11y/aria-proptypes": "warn",
    "jsx-a11y/aria-unsupported-elements": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/role-supports-aria-props": "warn",

    // Props declared as methods (`onSelect(type): void`) never use `this`.
    "typescript/unbound-method": "off",
    // Asks for <output> instead of role="status"; <output> is for form results, not page status.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      // shadcn primitives: Label gets htmlFor from its caller, and the input group addon only
      // forwards a mouse click to an input that is already reachable by keyboard.
      "files": ["src/components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    }
  ],
  "ignorePatterns": [".next/**", "node_modules/**", ".taste-skill/**", "docs/**", "next-env.d.ts"]
}
